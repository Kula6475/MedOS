# Safe zero-credential defaults.
MODEL_PROVIDER=mock
OBSERVABILITY_PROVIDER=local

# Required only for live Fireworks inference and the optional Copilot experience.
# Add real values privately to .env.local or deployment secret storage.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# Required only when OBSERVABILITY_PROVIDER=braintrust.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=MedOS

# Your Braintrust organization slug. Without it the SDK cannot build a permalink,
# so the UI "Inspect the Braintrust trace" link resolves to an error page.
# Set this (locally and in your deployment env) to make trace deep-links clickable.
BRAINTRUST_ORG_NAME=
# Optional override; defaults to the Braintrust cloud app when unset.
# BRAINTRUST_APP_URL=https://www.braintrust.dev
